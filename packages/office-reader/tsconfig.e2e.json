{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "composite": false,
    "declaration": false,
    "declarationMap": false,
    "emitDeclarationOnly": false,
    "noEmit": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "lib": ["es2022", "dom", "dom.iterable"],
    "types": ["jest", "node"]
  },
  "include": ["src/**/*.ts", "e2e/**/*.ts", "jest.e2e.config.cts"],
  "exclude": ["src/**/*.test.ts"]
}

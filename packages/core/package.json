{
  "name": "@opencraw/core",
  "version": "0.0.1",
  "type": "module",
  "main": "./dist/index.esm.js",
  "module": "./dist/index.esm.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/index.esm.js",
      "default": "./dist/index.esm.js"
    }
  },
  "files": [
    "dist",
    "!**/*.tsbuildinfo",
    "!**/*.d.ts.map",
    "!**/*.js.map"
  ],
  "dependencies": {
    "@opencraw/office-reader": "^0.0.1",
    "cheerio": "^1.2.0",
    "domhandler": "^6.0.1",
    "jsonpath-plus": "^10.4.0",
    "marked": "^18.0.14",
    "pdfjs-dist": "^6.3.289",
    "playwright": "^1.63.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  },
  "publishConfig": {
    "access": "public"
  },
  "description": "Recipe-driven crawler engine: JSON input recipes (Playwright browser or HTTP API steps) mapped through transforms to JSON output schemas.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/russoedu/open.craw.git",
    "directory": "packages/core"
  },
  "keywords": [
    "crawler",
    "scraper",
    "playwright",
    "recipe",
    "data-driven",
    "json"
  ],
  "engines": {
    "node": ">=22"
  },
  "sideEffects": false,
  "nx": {
    "targets": {
      "e2e": {
        "executor": "nx:run-commands",
        "dependsOn": [
          "build",
          "^build"
        ],
        "options": {
          "command": "tsc -p tsconfig.e2e.json && jest --config jest.e2e.config.cts",
          "cwd": "packages/core"
        }
      },
      "schemas": {
        "executor": "nx:run-commands",
        "dependsOn": [
          "build"
        ],
        "options": {
          "command": "node tools/emit-json-schemas.mjs",
          "cwd": "packages/core"
        }
      },
      "typecheck": {
        "dependsOn": [
          "^build"
        ]
      },
      "lint": {
        "dependsOn": [
          "^build"
        ]
      }
    }
  }
}
